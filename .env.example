# Heap Analytics Buddy Environment Variables
# Copy this file to .env and fill in your values

# Heap Analytics Credentials
HEAP_EMAIL=your-email@example.com
HEAP_PASSWORD=your-password

# Optional: Heap Organization ID (if you have multiple organizations)
# HEAP_ORG_ID=

# Browser Settings
# Options: firefox, chrome, playwright-firefox, playwright-chrome
BROWSER_TYPE=firefox

# Run browser in headless mode (no visible window)
# Set to 'true' for server/CI environments
BROWSER_HEADLESS=false

# Browser Profile Paths (for using existing login sessions)
# FIREFOX_PROFILE=default
# CHROME_USER_DATA=~/.config/google-chrome/Default

# Report Output Directory
REPORT_OUTPUT_DIR=./reports
